[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/default_filters/anisotropic_filtering_level=0
camera/depth_of_field/depth_of_field_bokeh_quality=2

[shader_globals]

light_grid_ambient={
"type": "sampler3D",
"value": ""
}
light_grid_direct={
"type": "sampler3D",
"value": ""
}
light_grid_cartesian={
"type": "sampler3D",
"value": ""
}
light_grid_normalize={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
light_grid_offset={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
